@@ -0,0 +1,95 @@
+import math
+from typing import List
+
+from gadapt.ga_model.candidate_solution import CandidateSolution
+from gadapt.operations.cost_finding.elitism_cost_finder import ElitismCostFinder
+from gadapt.utils.constraint_handling import ConstraintHandler, parse_pair
+
+
+class ConstraintHandlingCostFinder(ElitismCostFinder):
+    """
+    Cost finder for constraint_handling: the cost function returns (objective, violation). Each generation it
+    (1) evaluates the new candidate solutions, (2) updates the technique's parameters from the completed history,
+    (3) recomputes the scalar cost of ALL candidate solutions and the previous generation's minimal and average
+    cost under the current parameters (so improvement checks compare like with like), and only then (4) sorts by the
+    technique's key and keeps the best ones. It also tracks the best evaluated solution of the run: the feasible one
+    (violation 0) with the smallest objective, otherwise the one with the smallest violation.
+    """
+
+    def __init__(self, handler: ConstraintHandler, number_of_generations: int = -1):
+        super().__init__()
+        self.handler = handler
+        self.number_of_generations = number_of_generations
+        self._previous_best = None
+        self.best = None  # (objective, violation, values) of the best evaluated solution of the run
+
+    def _execute_function(self, cost_function, c: CandidateSolution):
+        sorted_variable_values = list(sorted(c, key=lambda vv: vv.decision_variable.variable_id))
+        values = [a.value for a in sorted_variable_values]
+        try:
+            c.objective_value, c.violation_value = parse_pair(cost_function(values))
+            c.succ = True
+        except Exception as ex:
+            print(ex)
+            c.objective_value, c.violation_value = None, math.inf
+            c.succ = False
+            return
+        if self._better_for_report(c.objective_value, c.violation_value):
+            self.best = (c.objective_value, c.violation_value,
+                         {vv.decision_variable.variable_id: vv.value for vv in sorted_variable_values})
+
+    def _better_for_report(self, objective, violation):
+        if self.best is None:
+            return True
+        best_objective, best_violation, _ = self.best
+        if violation == 0 or best_violation == 0:
+            return violation == 0 and (best_violation != 0 or objective < best_objective)
+        return violation < best_violation
+
+    def _progress(self) -> float:
+        """Elapsed share of the run (epsilon schedule); 0 without a generation limit."""
+        if self.number_of_generations is None or self.number_of_generations <= 0:
+            return 0.0
+        return min(1.0, self.population.population_generation / self.number_of_generations)
+
+    def _scalar_costs(self, candidates):
+        finite = [self.handler.cost(c.objective_value, c.violation_value) for c in candidates
+                  if c.objective_value is not None]
+        failure_cost = max(finite) if finite else None
+        return [self.handler.cost(c.objective_value, c.violation_value, failure_cost) for c in candidates]
+
+    def _find_costs_for_population(self):
+        if self.population is None:
+            raise Exception("population must not be null!")
+        incumbents = [c for c in self.population if not math.isnan(c.cost_value) and not (
+            c.is_immigrant and c.population_generation == self.population.population_generation)]
+        for c in self.population:
+            if math.isnan(c.cost_value) or (
+                c.is_immigrant and c.population_generation == self.population.population_generation
+            ):
+                self._execute_function(self.population.options.cost_function, c)
+        if not any(getattr(c, "_succ", False) for c in self.population):
+            raise ValueError("All evaluated candidate costs were invalid or nonfinite")
+        pairs = [(c.objective_value, c.violation_value) for c in self.population]
+        self.handler.start_generation(self._previous_best, pairs, self._progress())
+        for c, cost in zip(self.population, self._scalar_costs(list(self.population))):
+            c.cost_value = cost
+        if incumbents:
+            # the previous generation's references under the current parameters (adaptive penalty, epsilon)
+            kept = sorted(incumbents, key=lambda c: self.handler.key(c.objective_value, c.violation_value))
+            costs = [c.cost_value for c in kept]
+            self.population.previous_min_cost = costs[0]
+            n = max(1, self.population.options.keep_number - self.population.options.immigration_number)
+            without_immigrants = costs[:n]
+            self.population.previous_avg_cost = sum(without_immigrants) / len(without_immigrants)
+        better: List[CandidateSolution] = sorted(
+            self.population, key=lambda c: self.handler.key(c.objective_value, c.violation_value))
+        better = better[: self.population.options.keep_number]
+        self.population.best_individual = better[0]
+        self.population.min_cost = better[0].cost_value
+        without_immigrants = better[: self.population.options.keep_number - self.population.options.immigration_number]
+        self.population.avg_cost = sum(c.cost_value for c in without_immigrants) / len(without_immigrants)
+        self._log_population()
+        self.population.clear_and_add_candidate_solutions(better)
+        best = self.population.best_individual
+        self._previous_best = (best.objective_value, best.violation_value)
diff -ruN --exclude=__pycache__ /Users/danijel/Desktop/gadapt/gadapt/utils/constraint_handling.py gadapt_repo/gadapt/utils/constraint_handling.py
--- /Users/danijel/Desktop/gadapt/gadapt/utils/constraint_handling.py	1970-01-01 01:00:00
+++ gadapt_repo/gadapt/utils/constraint_handling.py	2026-10-24 12:29:38
@@ -0,0 +1,130 @@
+"""
+Constraint handling (opt-in, GA parameter constraint_handling): the cost function returns (objective, violation),
+violation >= 0 and 0 for a feasible solution. Selection uses an explicit comparison key; the scalar cost (cost_value)
+only feeds GAdapt's adaptation signals and the reported min_cost.
+"""
+import math
+import statistics
+from numbers import Real
+
+PENALTY = "penalty"
+ADAPTIVE_PENALTY = "adaptive_penalty"
+FEASIBILITY_RULES = "feasibility_rules"
+EPSILON = "epsilon"
+CONSTRAINT_HANDLING_STRINGS = [PENALTY, ADAPTIVE_PENALTY, FEASIBILITY_RULES, EPSILON]
+
+PATIENCE = 3  # adaptive penalty: generations in a row before the weight changes
+INCREASE, DECREASE = 2.0, 1.5
+WEIGHT_RANGE = 1e6  # the adaptive weight stays within [initial / 1e6, initial * 1e6]
+COST_LIMIT = 1e12  # penalty scalars for the adaptation are clipped to [-COST_LIMIT, COST_LIMIT]
+VALUE_LIMIT = 1e150  # |objective| and violation; with weights <= 1e106 every penalized objective stays finite
+EPSILON_PERCENTILE = 20  # epsilon: initial level from the initial population
+EPSILON_CONTROL_FRACTION, EPSILON_EXPONENT = 0.5, 5
+
+
+def parse_pair(result):
+    """(objective, violation) as floats; raises ValueError unless both are finite real numbers and violation >= 0."""
+    if not isinstance(result, (tuple, list)) or len(result) != 2:
+        raise ValueError("With constraint_handling, the cost function must return (objective, violation)")
+    objective, violation = result
+    for value in (objective, violation):
+        if isinstance(value, bool) or not isinstance(value, Real) or not math.isfinite(float(value)):
+            raise ValueError("The objective and the violation must be finite real numbers")
+    if violation < 0:
+        raise ValueError("The violation must be >= 0")
+    if abs(objective) > VALUE_LIMIT or violation > VALUE_LIMIT:
+        raise ValueError("The objective and the violation must be within ±1e150")
+    return float(objective), float(violation)
+
+
+class ConstraintHandler:
+    """
+    penalty: objective + weight * violation (Deb 2000 baseline).
+    adaptive_penalty: the weight is doubled after PATIENCE generations with an infeasible best candidate solution
+        and divided by 1.5 after PATIENCE feasible ones (Ben Hadj-Alouane and Bean 1997).
+    feasibility_rules: feasible before infeasible, by objective among feasible, by violation among infeasible
+        (Deb 2000).
+    epsilon: as feasibility_rules, with violation <= epsilon counted as feasible; epsilon decreases to 0 over the
+        first half of the run (Takahama and Sakai 2006).
+    A failed evaluation (objective None) is always last.
+    """
+
+    def __init__(self, technique, weight=1000.0):
+        if technique not in CONSTRAINT_HANDLING_STRINGS:
+            raise ValueError("constraint_handling must be one of " + ", ".join(CONSTRAINT_HANDLING_STRINGS))
+        self.technique = technique
+        self.initial_weight = self.weight = float(weight)
+        self.infeasible_streak = self.feasible_streak = 0
+        self.f_ref = None
+        self.epsilon0 = None
+        self.epsilon = 0.0
+
+    def start_generation(self, previous_best, initial_pairs, progress):
+        """Updates the parameters from the completed history. progress: elapsed share of the run in [0, 1]."""
+        if self.f_ref is None:
+            objectives = [abs(o) for o, _ in initial_pairs if o is not None]
+            self.f_ref = statistics.median(objectives) if objectives else 1.0
+            if self.f_ref == 0:
+                self.f_ref = 1.0
+        if self.technique == ADAPTIVE_PENALTY and previous_best is not None:
+            if previous_best[0] is not None and previous_best[1] == 0:
+                self.feasible_streak, self.infeasible_streak = self.feasible_streak + 1, 0
+            else:
+                self.infeasible_streak, self.feasible_streak = self.infeasible_streak + 1, 0
+            if self.infeasible_streak >= PATIENCE:
+                self.weight = min(self.weight * INCREASE, self.initial_weight * WEIGHT_RANGE)
+                self.infeasible_streak = self.feasible_streak = 0
+            elif self.feasible_streak >= PATIENCE:
+                self.weight = max(self.weight / DECREASE, self.initial_weight / WEIGHT_RANGE)
+                self.infeasible_streak = self.feasible_streak = 0
+        if self.technique == EPSILON:
+            if self.epsilon0 is None:
+                violations = sorted(v for o, v in initial_pairs if o is not None)
+                self.epsilon0 = _percentile(violations, EPSILON_PERCENTILE) if violations else 0.0
+            self.epsilon = (self.epsilon0 * (1 - progress / EPSILON_CONTROL_FRACTION) ** EPSILON_EXPONENT
+                            if progress < EPSILON_CONTROL_FRACTION else 0.0)
+
+    def is_feasible(self, objective, violation):
+        """Feasible in the technique's sense (epsilon: violation up to the current level)."""
+        if objective is None:
+            return False
+        return violation <= self.epsilon if self.technique == EPSILON else violation == 0
+
+    def _penalized(self, objective, violation):
+        """objective + weight * violation; finite for parsed pairs (VALUE_LIMIT) and bounded weights."""
+        return objective + self.weight * violation
+
+    def key(self, objective, violation):
+        """Selection key (smaller is better), exact for any finite values."""
+        if objective is None:
+            return (2, 0.0, 0.0)
+        if self.technique in (PENALTY, ADAPTIVE_PENALTY):
+            return (0, 0.0, self._penalized(objective, violation))
+        if self.is_feasible(objective, violation):
+            return (0, 0.0, objective)
+        return (1, 0.0, violation)
+
+    def cost(self, objective, violation, failure_cost=None):
+        """
+        The scalar cost_value (adaptation signals and min_cost). Rule-based techniques: 1 + u(objective) if feasible,
+        2 + violation / (1 + violation) if infeasible, 3 if failed, with u(f) = 1/2 + arctan(f / f_ref) / pi.
+        Penalties: the penalized objective; a failed evaluation gets failure_cost (the largest finite penalized cost
+        in the population), so a failure does not inflate the cost diversity.
+        """
+        if self.technique in (PENALTY, ADAPTIVE_PENALTY):
+            if objective is None:
+                return failure_cost if failure_cost is not None else 1.0
+            return max(-COST_LIMIT, min(COST_LIMIT, self._penalized(objective, violation)))
+        if objective is None:
+            return 3.0
+        if self.is_feasible(objective, violation):
+            return 1.0 + 0.5 + math.atan(objective / self.f_ref) / math.pi
+        return 2.0 + violation / (1.0 + violation)
+
+
+def _percentile(sorted_values, q):
+    """Linear-interpolation percentile (numpy's default) of a sorted, non-empty list."""
+    position = (len(sorted_values) - 1) * q / 100.0
+    low = math.floor(position)
+    high = min(low + 1, len(sorted_values) - 1)
+    return sorted_values[low] + (sorted_values[high] - sorted_values[low]) * (position - low)
--- /Users/danijel/Desktop/gadapt/README.md	2026-10-23 00:18:03
+++ gadapt_repo/README.md	2026-10-24 12:29:38
@@ -277,7 +277,26 @@
 **ensure_unique_individuals**=*None* - If this parameter has a True value, the genetic algorithm ensures that no two individuals have the same variable values: offspring and mutated candidate solutions that repeat values already seen during the optimisation are regenerated, so the cost function is not evaluated twice for the same values. Duplicates are only likely when the variables take values from a grid defined by the step, so the default (*None*) means *True* when all variables have a step, and *False* when any variable is continuous (added without a step). Set it explicitly to *True* or *False* to override this. Ensuring uniqueness adds some computation per generation, especially late in the optimisation, which is usually negligible compared to the cost function execution time.
 
 **probe_cost_function**=*True* - Before the optimization, the parameter validation calls the cost function once with all minimal and once with all maximal values of the decision variables, to check that it returns a float. These two calls are real cost function evaluations, and they are not part of the search: their results are not added to the population. If the cost function is expensive, or if its evaluations are counted (for example, against a budget), set it to *False* to skip these two calls.
+
+**constraint_handling**=*None* - How constraints are handled. With *None*, the cost function returns the cost, as in all examples above (constraints, if any, are the user's penalty inside the cost). With a technique name, the cost function returns a pair *(objective, violation)*, where *violation* is 0 for a feasible solution and positive otherwise (both finite, within ±10¹⁵⁰) (for example, the sum of the constraint violations), and GAdapt ranks the candidate solutions with that technique: *"penalty"* uses objective + *constraint_penalty_weight* · violation; *"adaptive_penalty"* starts from the same weight, doubles it after three generations in a row with an infeasible best candidate solution and divides it by 1.5 after three feasible ones; *"feasibility_rules"* puts every feasible solution before every infeasible one, compares feasible solutions by objective and infeasible ones by violation; *"epsilon"* works like *"feasibility_rules"*, but violations up to a level that decreases to 0 over the first half of *number_of_generations* count as feasible (it needs *number_of_generations* > 0; if the run stops earlier, the level may still be positive at the end). The survivors are chosen by the exact order of the technique; the adaptation (cost diversity, parent diversity), the parent selection and the immigration read a scalar of that order (*min_cost* reports it): the penalized cost clipped to ±10¹², or, for the rule-based techniques, a value in [1, 3] that saturates only far outside the scale of the initial objectives. The results then describe the best evaluated solution of the whole run: the feasible one with the smallest objective, or, if none is feasible, the one with the smallest violation (*best_objective*, *best_violation*, *feasible* and its *result_values*). It cannot be combined with *mutation_operator_policy*. With *probe_cost_function*, the two probe calls must return valid pairs.
+
+```python
+from gadapt.ga import GA
+
+def objective_and_violation(args):
+    x, y = args
+    return (x - 2) ** 2 + (y - 1) ** 2, max(0.0, x + y - 2)  # minimize, subject to x + y <= 2
+
+ga = GA(cost_function=objective_and_violation, constraint_handling="feasibility_rules",
+        exit_check="generations", number_of_generations=80)
+ga.add(-3.0, 3.0, 0.01)
+ga.add(-3.0, 3.0, 0.01)
+results = ga.execute()
+print(results.best_objective, results.best_violation, results.result_values)
+```
 
+**constraint_penalty_weight**=*1000.0* - The weight of the violation for *constraint_handling="penalty"*, and the initial weight for *"adaptive_penalty"* (which then stays within a factor of 10⁶ of it). At most 10¹⁰⁰.
+
 **logging**=*False* - If this parameter has a True value, the log file will be created in the current working directory. The log file contains the flow of genetic algorithm execution, along with values of candidate solutions, decision variables and cost functions in each generation
 
